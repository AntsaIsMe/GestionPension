<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.pension.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Pane prefHeight="563.0" prefWidth="723.0">
      <children>
         <Pane layoutX="2.0" layoutY="1.0" prefHeight="563.0" prefWidth="420.0" style="-fx-background-color: #AAAAAA;">
            <children>

                <Label fx:id="welcomeText" contentDisplay="CENTER" layoutX="46.0" layoutY="141.0" prefHeight="129.0" prefWidth="268.0" text="      GESTION DES PENSIONS DES RETRAITEES" textAlignment="JUSTIFY" textOverrun="LEADING_ELLIPSIS">
                  <opaqueInsets>
                     <Insets />
                  </opaqueInsets>
               </Label>
            </children>
         </Pane>
         <Pane layoutX="402.0" layoutY="2.0" prefHeight="563.0" prefWidth="319.0" style="-fx-background-color: #AAAAA3;">
            <children>
               <Button layoutX="118.0" layoutY="145.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="104.0" style="-fx-background-color: #FFFF;" text="TARIF">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Button layoutX="115.0" layoutY="204.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="110.0" text="PERSONNE">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Button layoutX="115.0" layoutY="269.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="110.0" text="PENSION" />
               <Button layoutX="112.0" layoutY="327.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="116.0" text="HISTOGRAMME">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
            </children>
         </Pane>
      </children>
   </Pane>
    <Button onAction="#onHelloButtonClick" text="Hello!" />
</VBox>
