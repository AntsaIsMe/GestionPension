    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
   <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Ajouter une personne">
      <font>
         <Font size="38.0" />
      </font>
   </Text>
   <Pane prefHeight="200.0" prefWidth="200.0">
      <children>
         <Pane layoutX="266.0" prefHeight="200.0" prefWidth="295.0">
            <children>
               <TextField layoutX="71.0" layoutY="24.0" promptText="Contact" />
               <ComboBox layoutX="72.0" layoutY="67.0" prefWidth="150.0" promptText="Situation" visibleRowCount="3" />
               <TextField layoutX="72.0" layoutY="109.0" promptText="Nom du conjoint" />
               <TextField layoutX="72.0" layoutY="150.0" promptText="Prénom du conjoint" />
            </children>
         </Pane>
         <Pane prefHeight="200.0" prefWidth="277.0">
            <children>
               <TextField layoutX="50.0" layoutY="23.0" promptText="Nom" />
               <TextField layoutX="50.0" layoutY="61.0" promptText="Prenom" />
               <DatePicker layoutX="39.0" layoutY="101.0" promptText="Date de naissance" />
               <TextField layoutX="39.0" layoutY="147.0" promptText="Diplome" />
               <Separator layoutX="274.0" layoutY="1.0" orientation="VERTICAL" prefHeight="200.0" />
            </children>
         </Pane>
      </children>
   </Pane>
   <Button mnemonicParsing="false" text="Ajouter" />
</VBox>
