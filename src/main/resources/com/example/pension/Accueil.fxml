<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pension.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Pane prefHeight="563.0" prefWidth="723.0">
      <children>
         <Pane layoutX="2.0" layoutY="1.0" prefHeight="563.0" prefWidth="420.0" style="-fx-background-image: #AAAAAA;">
            <children>
               <StackPane layoutX="1.0" layoutY="-1.0" prefHeight="563.0" prefWidth="400.0">
                  <children>
                     <ImageView fitHeight="560.0" fitWidth="396.0" pickOnBounds="true" preserveRatio="true" />
                  </children>
               </StackPane>
            </children>
         </Pane>
         <Pane layoutX="402.0" layoutY="2.0" prefHeight="563.0" prefWidth="319.0" style="-fx-background-color: #AAAAA3;">
            <children>
               <Button layoutX="118.0" layoutY="145.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="104.0" style="-fx-background-color: #86584D;" text="TARIF" textFill="WHITE">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Button layoutX="115.0" layoutY="204.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="110.0" style="-fx-background-color: #86584D;" text="PERSONNE" textFill="WHITE">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Button layoutX="115.0" layoutY="269.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="110.0" style="-fx-background-color: #86584D;" text="PENSION" textFill="WHITE" />
               <Button layoutX="112.0" layoutY="327.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="116.0" style="-fx-background-color: #86584D;" text="HISTOGRAMME" textFill="WHITE">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
            </children>
         </Pane>
      </children>
   </Pane>
    <Button onAction="#onHelloButtonClick" text="Hello!" />
</VBox>
